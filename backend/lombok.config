# Lombok sinh constructor cho @RequiredArgsConstructor nhưng MẶC ĐỊNH không mang
# annotation trên field xuống tham số constructor. Với @Lazy thì đó là lỗi chỉ lộ
# ra lúc khởi động: bean tự tiêm chính nó (CrawlServiceImpl, NormalizeServiceImpl —
# cần proxy để @Async còn hiệu lực) sẽ tạo vòng phụ thuộc và Spring từ chối dựng
# context, dù mã vẫn biên dịch sạch.
lombok.copyableAnnotations += org.springframework.context.annotation.Lazy
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
